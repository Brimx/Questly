%% Questly — EER completo en estructura Chen.
%% Rectángulos: entidades. Rombos: relaciones. Cápsulas: atributos (Mermaid no ofrece el óvalo Chen nativo).
%% En Mermaid Live Editor se puede sustituir cada atributo por una elipse visual.
flowchart LR
  %% Entidades
  U["Usuario_persona"]
  H["Habito_tarea"]
  M["Meta"]
  R["Recompensa"]
  RM["Recordatorio"]
  SK["Habilidad"]
  A["Animo"]
  C["Cumplimiento"]

  %% Relaciones y cardinalidades mín..máx
  U ---|"0..N"| T{tiene}
  T ---|"1..1"| H
  U ---|"0..N"| RA{registra}
  RA ---|"1..1"| A
  U ---|"0..N"| D{desarrolla}
  D ---|"1..1"| SK
  H ---|"0..N"| CF{configura}
  CF ---|"1..1"| RM
  H ---|"0..N"| RC{registra}
  RC ---|"1..1"| C
  H ---|"0..N"| DM{define}
  DM ---|"0..1"| M
  H ---|"0..N"| AR{asocia}
  AR ---|"0..1"| R
  U ---|"0..N"| O{obtiene}
  O ---|"0..N"| R

  %% Atributos de Usuario_persona
  U --- U_id(["<u>id_usuario</u>"])
  U --- U_correo(["correo (UQ)"])
  U --- U_nombre(["nombre"])
  U --- U_rol(["rol"])
  U --- U_fn(["fecha_nacimiento"])
  U --- U_desc(["descripcion_tu"])
  U --- U_px(["puntos_experiencia"])
  U --- U_nivel(["nivel"])

  %% Atributos de Habito_tarea
  H --- H_id(["<u>id_habito</u>"])
  H --- H_nombre(["nombre"])
  H --- H_importancia(["nivel_importancia"])
  H --- H_tiempo(["tiempo_invertido"])
  H --- H_inicio(["fecha_inicio"])
  H --- H_final(["fecha_final"])
  H --- H_frecuencia(["frecuencia"])

  %% Atributos de Meta
  M --- M_id(["<u>id_meta</u>"])
  M --- M_desc(["descripcion"])
  M --- M_obj(["valor_objetivo"])
  M --- M_fecha(["fecha_limite"])

  %% Atributos de Recompensa
  R --- R_id(["<u>id_recompensa</u>"])
  R --- R_nombre(["nombre (UQ)"])
  R --- R_desc(["descripcion"])
  R --- R_puntos(["puntos_necesarios"])

  %% La tabla Usuario_Recompensa se representa conceptualmente como la relación N:M.
  O --- O_fecha(["fecha_obtencion"])

  %% Atributos de Recordatorio
  RM --- RM_id(["<u>id_recordatorio</u>"])
  RM --- RM_fecha(["fecha_hora"])
  RM --- RM_mensaje(["mensaje"])
  RM --- RM_rep(["repeticion"])

  %% Atributos de Habilidad
  SK --- SK_id(["<u>id_habilidad</u>"])
  SK --- SK_nombre(["nombre_habilidad"])
  SK --- SK_desc(["descripcion"])
  SK --- SK_nivel(["nivel_habilidad"])
  SK --- SK_origen(["tipo_origen"])

  %% Atributos de Animo
  A --- A_id(["<u>id_animo</u>"])
  A --- A_estado(["estado_actual"])
  A --- A_comentario(["comentario"])
  A --- A_fecha(["fecha_registro TIMESTAMP"])

  %% Atributos de Cumplimiento
  C --- C_id(["<u>id_cumplimiento</u>"])
  C --- C_fecha(["fecha_cumplimiento"])

  %% Métricas derivadas de la vista estadistica_habito (no son columnas almacenadas).
  H --- S_total(["total_completado (derivado)"])
  H --- S_pct(["porcentaje_cumplido (derivado)"])
  H --- S_racha(["racha_actual (derivado)"])

  class U,H,M,R,RM,SK,A,C entity
  class T,RA,D,CF,RC,DM,AR,O relation
  class U_id,U_correo,U_nombre,U_rol,U_fn,U_desc,U_px,U_nivel attribute
  class H_id,H_nombre,H_importancia,H_tiempo,H_inicio,H_final,H_frecuencia attribute
  class M_id,M_desc,M_obj,M_fecha attribute
  class R_id,R_nombre,R_desc,R_puntos attribute
  class O_fecha,RM_id,RM_fecha,RM_mensaje,RM_rep,SK_id,SK_nombre,SK_desc,SK_nivel,SK_origen attribute
  class A_id,A_estado,A_comentario,A_fecha,C_id,C_fecha attribute
  class S_total,S_pct,S_racha derived

  classDef entity fill:#f8fafc,stroke:#172033,stroke-width:2px,color:#172033
  classDef relation fill:#fff7ed,stroke:#172033,stroke-width:2px,color:#172033
  classDef attribute fill:#ffffff,stroke:#334155,stroke-width:1.5px,color:#172033
  classDef derived fill:#ffffff,stroke:#334155,stroke-width:1.5px,stroke-dasharray:5 5,color:#172033
